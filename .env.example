# ─── Clerk Authentication ────────────────────────────────────────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_JWT_KEY=your_clerk_jwt_key_here

# ─── Neon PostgreSQL ─────────────────────────────────────────────────────────
# https://console.neon.tech → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── Cloudflare R2 Storage ───────────────────────────────────────────────────
# https://dash.cloudflare.com → R2 → Manage R2 API tokens
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
