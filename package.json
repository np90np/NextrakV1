{
  "name": "sitevant-main",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npx vercel --prod --yes",
    "migrate:schema": "psql \"$DATABASE_URL\" -f migrations/001_init_neon.sql",
    "migrate:receipts": "psql \"$DATABASE_URL\" -f migrations/002_add_receipt_key.sql",
    "migrate:machine-photos": "psql \"$DATABASE_URL\" -f migrations/003_add_machine_checklist_photo.sql",
    "migrate:schema:node": "tsx scripts/run-migrations.ts migrations/001_init_neon.sql",
    "migrate:receipts:node": "tsx scripts/run-migrations.ts migrations/002_add_receipt_key.sql",
    "migrate:machine-photos:node": "tsx scripts/run-migrations.ts migrations/003_add_machine_checklist_photo.sql",
    "migrate:all:node": "npm run migrate:schema:node && npm run migrate:receipts:node && npm run migrate:machine-photos:node",
    "migrate:data": "tsx scripts/migrate-from-supabase.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@clerk/nextjs": "^7.3.5",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^5.0.0",
    "@mui/icons-material": "^5.16.0",
    "@mui/material": "^5.16.0",
    "@mui/material-nextjs": "^9.0.1",
    "date-fns": "^2.30.0",
    "next": "^16.2.6",
    "pdfkit": "^0.18.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.16.0",
    "typescript": "^5.6.2"
  }
}
