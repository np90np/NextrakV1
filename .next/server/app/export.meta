{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/export/layout,_N_T_/(app)/export/page,_N_T_/export"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/export/__PAGE__",
    "/!KGFwcCk/export",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}